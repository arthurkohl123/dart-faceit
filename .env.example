NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_APP_URL=https://www.rankeddarts.de
STRIPE_SECRET_KEY=sk_live_or_test_key
STRIPE_PREMIUM_PRICE_ID=price_...
# Optional recurring annual Premium price. When unset, the monthly plan remains available.
STRIPE_PREMIUM_YEARLY_PRICE_ID=
# Optional one-time Premium gift prices. Leave an offer empty to keep that
# duration unavailable; the browser never supplies Stripe price identifiers.
STRIPE_PREMIUM_GIFT_30D_PRICE_ID=
STRIPE_PREMIUM_GIFT_90D_PRICE_ID=
STRIPE_PREMIUM_GIFT_365D_PRICE_ID=
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional: Discord/Slack-compatible webhook for immediate critical alerts.
MONITORING_ALERT_WEBHOOK_URL=https://...
# Discord webhook for automatic tournament announcements in the configured channel.
# Keep this server-side; never prefix it with NEXT_PUBLIC_.
DISCORD_TOURNAMENT_WEBHOOK_URL=https://discord.com/api/webhooks/...
# Discord OAuth2 + bot credentials for the optional profile link and Premium role sync.
# The bot must be a member of the server and its role must be above both managed roles.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=1350044109448155196
DISCORD_PREMIUM_ROLE_ID=
# Optional: Discord role ID for manually approved RankedDarts streamers.
DISCORD_STREAMER_ROLE_ID=
DISCORD_OAUTH_STATE_SECRET=
# Keep this callback URL identical to the Discord Developer Portal redirect URI.
DISCORD_REDIRECT_URI=https://www.rankeddarts.de/api/discord/callback
# Vercel Hobby runs the server-side role reconciliation once per day.
CRON_SECRET=
# Twitch app credentials for the public streamer overview. Keep both server-side.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

