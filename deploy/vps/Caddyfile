rankeddarts.de {
  redir https://www.rankeddarts.de{uri} permanent
}

www.rankeddarts.de {
  encode zstd gzip
  reverse_proxy app:3000
}

# The Supabase gateway has no published port. Caddy reaches it only over its
# private Docker network while providing the public TLS endpoint.
api.rankeddarts.de {
  encode zstd gzip
  reverse_proxy api-gw:8000
}
